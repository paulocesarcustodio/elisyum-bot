{
  "name": "lbot-whatsapp",
  "version": "3.5.0",
  "description": "Bot brasileiro para Whatsapp com diversas utilidades para o dia-a-dia.",
  "type": "module",
  "main": "dist/app.js",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "setup": "python3 scripts/setup-local.py",
    "start": "python3 scripts/local-runtime.py start",
    "start:simple": "bun dist/app.js",
    "clean": "rimraf dist/ .tsbuildinfo",
    "copy-media": "copyfiles -u 2 src/media/* dist/media",
    "preflight:storage": "bun run scripts/storage-preflight.ts",
    "dev": "python3 scripts/local-runtime.py restart",
    "build": "bun run clean && bun run tsc && bun run copy-media",
    "zip": "bun run build && bestzip LBOT-v$npm_package_version.zip dist package.json LICENSE bun.lock",
    "tsc": "tsc",
    "semantic:bench": "bun run scripts/semantic-command.bench.ts",
    "voice:bench": "bun run scripts/voice-command.bench.ts",
    "local:build": "python3 scripts/local-runtime.py build",
    "local:stop": "python3 scripts/local-runtime.py stop",
    "db:migrate": "bun scripts/migrate-postgres.ts elysium"
  },
  "author": "Leal",
  "license": "GPL-3.0-only",
  "repository": "git+https://github.com/victorsouzaleal/lbot-whatsapp.git",
  "keywords": [
    "whatsapp",
    "whatsapp-bot",
    "bot",
    "sticker"
  ],
  "engines": {
    "bun": "1.4.0"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/format-duration": "3.0.0",
    "@types/fs-extra": "11.0.4",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/qrcode-terminal": "0.12.2",
    "@types/user-agents": "1.0.4",
    "@types/yt-search": "2.10.3",
    "bestzip": "2.2.7",
    "coloredcli": "1.0.30",
    "copyfiles": "2.4.1",
    "cross-env": "7.0.3",
    "drizzle-kit": "0.31.10",
    "rimraf": "6.1.3",
    "rollup": "4.63.5",
    "tsc-alias": "1.9.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "5.1.4"
  },
  "dependencies": {
    "@deepgram/sdk": "3.13.0",
    "@google/generative-ai": "0.24.1",
    "@hapi/boom": "10.0.1",
    "@mrnima/instagram-downloader": "1.0.0",
    "@napi-rs/image": "1.15.0",
    "@tobyg74/tiktok-api-dl": "1.3.7",
    "@victorsouzaleal/brasileirao": "1.1.2",
    "@victorsouzaleal/googlethis": "1.8.1",
    "@vitalets/google-translate-api": "9.2.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "adm-zip": "0.5.18",
    "axios": "1.20.0",
    "canvas": "3.2.3",
    "chalk": "4.1.2",
    "drizzle-orm": "0.45.3",
    "emoji-mixer": "1.3.1",
    "fb-downloader-scrapper": "3.0.1",
    "file-type": "20.5.0",
    "form-data": "4.0.6",
    "format-duration": "3.0.2",
    "fs-extra": "11.4.1",
    "fuse.js": "7.5.0",
    "genius-lyrics": "4.4.7",
    "google-sr": "5.0.0",
    "jimp": "1.6.1",
    "jsdom": "26.1.0",
    "moment-timezone": "0.5.48",
    "node-cache": "5.1.2",
    "node-gtts": "2.0.2",
    "node-upload-images": "1.0.1",
    "node-webpmux": "3.2.1",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "pino": "7.11.0",
    "pretty-num": "0.5.2",
    "qrcode-terminal": "0.12.0",
    "spotify-url-info": "3.3.3",
    "user-agents": "1.1.675",
    "yt-search": "2.13.1",
    "ytdlp-nodejs": "2.3.5"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "audio-decode": "2.2.3",
    "link-preview-js": "3.2.0"
  },
  "resolutions": {
    "libsignal": "^6.0.0"
  }
}
